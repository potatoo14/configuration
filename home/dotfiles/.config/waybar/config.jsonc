{
  "include": ["./local.jsonc"],
  "modules-center": ["clock"],
  "modules-left": ["hyprland/workspaces", "hyprland/window"],
  "position": "top",
  "tray": { "icon-size": 16, "spacing": 10 },
  "battery": {
    "format": "bat:{capacity}%",
    "states": { "critical": 15, "warning": 30 },
  },
  "bluetooth": {
    "format": "",
    "format-connected": "blu:{device_battery_percentage}%",
    "tooltip-format": "{device_alias}",
  },
  "clock": {
    "calendar": {
      "format": {
        "days": "<span color='#cdd6f4'><b>{}</b></span>",
        "months": "<span color='#cdd6f4'><b>{}</b></span>",
        "today": "<span color='#f38ba8'><b>{}</b></span>",
        "weekdays": "<span color='#cdd6f4'><b>{}</b></span>",
        "weeks": "<span color='#cdd6f4'><b>W{}</b></span>",
      },
      "mode": "month",
    },
    "format": "{:%a %d %b %Y %H:%M}",
    "interval": 60,
    "on-click": "vicinae toggle",
    "tooltip-format": "<tt>{calendar}</tt>",
  },
  "cpu": {
    "format": "cpu:{usage}%",
    "interval": 2,
    "states": { "critical": 90, "warning": 70 },
  },
  "backlight": {
    "format": "light:{percent}%",
    "on-scroll-down": "~/.config/hypr/bin/brightness.sh -",
    "on-scroll-up": "~/.config/hypr/bin/brightness.sh +",
    "tooltip": false,
  },
  "custom/backlight": {
    "exec": "ddcutil -t getvcp 0x10|awk '{print $4}'",
    "format": "light:{}%",
    "on-scroll-down": "~/.config/hypr/bin/brightness.sh -",
    "on-scroll-up": "~/.config/hypr/bin/brightness.sh +",
    "signal": 2,
    "tooltip": false,
  },
  "custom/shader": {
    "exec": "cat ~/.config/hypr/blue-light-filter.glsl|head -n 1|cut -c4-99",
    "format": "shader:{}",
    "on-scroll-down": "~/.config/hypr/bin/shader.py -",
    "on-scroll-up": "~/.config/hypr/bin/shader.py +",
    "signal": 1,
    "tooltip": false,
  },
  "custom/uptime": {
    "exec": "~/.config/waybar/uptime.py",
    "format": "uptime:{}",
    "interval": 60,
    "tooltip": false,
  },
  "hyprland/language": {
    "format": "{}",
    "format-en": "en",
    "format-en-intl": "intl",
    "on-click": "~/.config/hypr/bin/switchKbLayout.sh",
  },
  "hyprland/window": { "format": "{}" },
  "hyprland/workspaces": {
    "format": "{icon}",
    "on-click": "activate",
    "on-scroll-down": "hyprctl dispatch workspace r+1",
    "on-scroll-up": "hyprctl dispatch workspace r-1",
  },
  "layer": "top",
  "memory": {
    "format": "ram:{}%",
    "interval": 2,
    "states": { "critical": 90, "warning": 70 },
  },
  "wireplumber": {
    "format": "vol:{volume}%",
    "format-muted": "muted",
    "ignored-sinks": ["Easy Effects Sink"],
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-scroll-down": "~/.config/hypr/bin/volume.sh -",
    "on-scroll-up": "~/.config/hypr/bin/volume.sh +",
  },
}
